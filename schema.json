{
  "name": "resume_extraction",
  "strict": true,
  "schema": {
    "type": "object",
    "properties": {
      "candidate_name": {
        "type": [
          "string",
          "null"
        ]
      },
      "skills": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "years_of_experience": {
        "type": [
          "number",
          "null"
        ]
      },
      "education": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "strengths": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "gaps": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "skill_evidence": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "skill": {
              "type": "string"
            },
            "evidence": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "skill",
            "evidence"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "candidate_name",
      "skills",
      "years_of_experience",
      "education",
      "strengths",
      "gaps",
      "skill_evidence"
    ],
    "additionalProperties": false
  }
}